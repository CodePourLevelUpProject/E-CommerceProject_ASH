@startuml
title 광고 배너 우선순위 시스템 클래스 다이어그램

class Banner {
  - bannerId: Long
  - title: String
  - imageUrl: String
  - linkUrl: String
  - priority: int
  - advertisingCost: BigDecimal
  - clickCount: int
  - viewCount: int
  - isActive: boolean
  - startDate: Date
  - endDate: Date
  + calculatePriorityScore()
  + trackClick()
  + trackView()
  + checkExpiry()
}

class BannerService {
  + calculatePriorityScore(advertisingCost: BigDecimal, clickRate: double)
  + getActiveBanners()
  + updateBannerStats(bannerId: Long, type: String)
}

class Admin {
  - adminId: Long
  - permissions: List<String>
  + manageBanner()
}

Admin "1" --> "*" Banner : manages
BannerService --> Banner

@enduml