@startuml
title 상품 카테고리 구조 클래스 다이어그램

class Category {
  - categoryId: Long
  - name: String
  - parentCategoryId: Long
  - isActive: boolean
  - productCount: int
  - createdAt: Date
  + getSubCategories()
  + getParentCategory()
  + updateProductCount()
  + isLeafCategory()
}

class CategoryService {
  + getCategoryTree()
  + getCategoryId(parentName: String, childName: String)
  + updateCategoryProductCount(categoryId: Long)
  + getActiveCategories()
}

class Product {
  - productId: Long
  - categoryId: Long
  - name: String
  - isActive: boolean
  - stock: int
}

class ProductController {
  + getProductsByCategory(categoryId: Long)
  + getCategoryNavigation()
}

Category "1" --> "*" Category : has_subcategories
Category "1" --> "*" Product : contains
CategoryService --> Category
ProductController --> CategoryService

@enduml