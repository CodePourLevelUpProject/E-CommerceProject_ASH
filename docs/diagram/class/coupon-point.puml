@startuml
title 쿠폰 및 포인트 시스템 클래스 다이어그램

class Coupon {
  - couponId: Long
  - code: String
  - discountRate: double
  - discountAmount: BigDecimal
  - minOrderAmount: BigDecimal
  - maxDiscountAmount: BigDecimal
  - status: CouponStatus
  - expiryDate: Date
  - usageLimit: int
  - usedCount: int
  + validateUsage(orderAmount: BigDecimal)
  + calculateDiscount(orderAmount: BigDecimal)
  + use()
}

class Point {
  - pointId: Long
  - userId: Long
  - balance: int
  - totalEarned: int
  - totalUsed: int
  + charge(amount: int, reason: String)
  + use(amount: int, reason: String)
  + validateUsage(amount: int, orderAmount: BigDecimal)
  + calculateUsageLimit(orderAmount: BigDecimal)
}

class PointHistory {
  - historyId: Long
  - userId: Long
  - amount: int
  - type: PointType
  - description: String
  - createdAt: Date
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PointType {
  CHARGE
  USE
}

Coupon --> CouponStatus
Point "1" --> "*" PointHistory : logs
PointHistory --> PointType

@enduml