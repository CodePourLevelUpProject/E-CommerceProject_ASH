@startuml
title 전화번호 인증 시스템 클래스 다이어그램

class PhoneVerification {
  - verificationId: Long
  - phoneNumber: String
  - verificationCode: String
  - isVerified: boolean
  - expiryTime: Date
  - attemptCount: int
  + sendVerificationCode()
  + verifyCode(code: String)
  + checkExpiry()
  + incrementAttempt()
}

class SmsService {
  - apiKey: String
  - apiSecret: String
  + sendSms(phoneNumber: String, message: String)
  + generateVerificationCode()
}

class User {
  - userId: Long
  - phoneNumber: String
  - isPhoneVerified: boolean
  + updatePhoneNumber(phoneNumber: String)
  + markPhoneVerified()
}

PhoneVerification "*" --> "1" SmsService : uses
User "1" --> "*" PhoneVerification : requests

@enduml