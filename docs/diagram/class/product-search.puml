@startuml
title 상품 검색 시스템 클래스 다이어그램

class ProductController {
  + searchProducts(keyword: String)
  + filterProducts(filters: Map)
  + getProductsByCategory(categoryId: Long)
}

class SearchController {
  + search(keyword: String, page: int)
  + getRecommendedProducts(keyword: String)
}

class ProductService {
  + searchProducts(keyword: String)
  + filterProducts(filters: Map)
  + sortProducts(sortType: String)
  + getProductsByCategory(categoryId: Long)
}

class CacheService {
  + getSearchCache(keyword: String)
  + cacheSearchResult(keyword: String, results: List)
}

class Product {
  - productId: Long
  - name: String
  - brand: String
  - price: BigDecimal
  - rating: double
  - stock: int
  - categoryId: Long
  + calculateDiscountPrice()
}

ProductController --> ProductService
SearchController --> ProductService
SearchController --> CacheService
ProductService --> Product

@enduml