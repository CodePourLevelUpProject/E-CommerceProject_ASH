@startuml
title 광고 배너 우선순위 시스템 ERD

entity "banners" as banner {
  * banner_id : BIGINT AUTO_INCREMENT <<PK>>
  * admin_id : BIGINT <<FK>>
  --
  * title : VARCHAR(255) NOT NULL
  * image_url : VARCHAR(500) NOT NULL
  link_url : VARCHAR(500)
  * priority : INT DEFAULT 0
  advertising_cost : DECIMAL(10,2) DEFAULT 0.00
  click_count : INT DEFAULT 0
  view_count : INT DEFAULT 0
  is_active : TINYINT(1) DEFAULT 1
  start_date : TIMESTAMP
  end_date : TIMESTAMP
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "admins" as admin {
  * admin_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  * admin_name : VARCHAR(100) NOT NULL
  permissions : JSON
}

admin ||--o{ banner : manages

@enduml