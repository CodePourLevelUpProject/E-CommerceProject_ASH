@startuml
title 리뷰 시스템 ERD

entity "reviews" as review {
  * review_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * order_id : BIGINT <<FK>>
  --
  * rating : TINYINT CHECK (rating >= 1 AND rating <= 5)
  content : TEXT
  image_urls : JSON
  is_verified : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "products" as product {
  * product_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  rating : DECIMAL(2,1) DEFAULT 0.0
  review_count : INT DEFAULT 0
}

entity "orders" as orders {
  * order_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * status : ENUM('PENDING', 'PAID', 'PREPARING', 'SHIPPED', 'DELIVERED', 'CANCELLED')
  delivered_at : TIMESTAMP
}

entity "order_items" as order_item {
  * order_item_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  --
  * quantity : INT NOT NULL
}

review }o--|| product : reviews
review }o--|| orders : based_on
orders ||--o{ order_item : includes

@enduml