@startuml
title 장바구니 관리 시스템 ERD

entity "shopping_carts" as cart {
  * cart_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "cart_items" as cart_item {
  * cart_item_id : BIGINT AUTO_INCREMENT <<PK>>
  * cart_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  --
  * quantity : INT NOT NULL DEFAULT 1
  added_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "cart_item_options" as cart_item_option {
  * cart_item_option_id : BIGINT AUTO_INCREMENT <<PK>>
  * cart_item_id : BIGINT <<FK>>
  * option_id : BIGINT <<FK>>
  --
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "product_options" as product_option {
  * option_id : BIGINT AUTO_INCREMENT <<PK>>
  * product_id : BIGINT <<FK>>
  --
  * option_type : VARCHAR(50) NOT NULL
  * option_value : VARCHAR(100) NOT NULL
  additional_price : DECIMAL(10,2) DEFAULT 0.00
  stock : INT DEFAULT 0
}

cart ||--o{ cart_item : contains
cart_item ||--o{ cart_item_option : has
cart_item_option }o--|| product_option : selects

@enduml