@startuml
title 상품 랭킹 시스템 시퀀스 다이어그램

participant BatchScheduler
entity ProductService
database DB

BatchScheduler -> ProductService : updateSalesRanking()
ProductService -> DB : SELECT product_id, SUM(quantity) as sales_count\nFROM order_items oi JOIN orders o\nWHERE o.status = 'DELIVERED'\nAND o.order_date >= DATE_SUB(NOW(), INTERVAL 30 DAY)
DB --> ProductService : 판매량 데이터
ProductService -> DB : UPDATE product_rankings\nSET rank = ?, score = ?\nWHERE ranking_type = 'SALES'

BatchScheduler -> ProductService : updateReviewRanking()
ProductService -> DB : SELECT product_id, COUNT(*) as review_count,\nAVG(rating) as avg_rating FROM reviews\nGROUP BY product_id\nHAVING avg_rating >= 4.0 AND review_count >= 10
DB --> ProductService : 리뷰 데이터
ProductService -> DB : UPDATE product_rankings\nSET rank = ?, score = ?\nWHERE ranking_type = 'REVIEW'

@enduml