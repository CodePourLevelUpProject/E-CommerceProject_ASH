@startuml
entity "users" as user {
  * user_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  * mail : VARCHAR(255) UNIQUE NOT NULL
  password : VARCHAR(255)
  * name : VARCHAR(100) NOT NULL
  phone_number : VARCHAR(20) UNIQUE
  oauth_provider : ENUM('KAKAO', 'GOOGLE', 'NAVER')
  oauth_id : VARCHAR(255)
  is_phone_verified : TINYINT(1) DEFAULT 0
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "addresses" as address {
  * address_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * recipient_name : VARCHAR(100) NOT NULL
  * phone_number : VARCHAR(20) NOT NULL
  * address : TEXT NOT NULL
  is_default : TINYINT(1) DEFAULT 0
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "admins" as admin {
  * admin_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  * admin_name : VARCHAR(100) NOT NULL
  permissions : JSON
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "shopping_carts" as cart {
  * cart_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "cart_items" as cart_item {
  * cart_item_id : BIGINT AUTO_INCREMENT <<PK>>
  * cart_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  --
  * quantity : INT NOT NULL DEFAULT 1
  added_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "products" as product {
  * product_id : BIGINT AUTO_INCREMENT <<PK>>
  * category_id : BIGINT <<FK>>
  --
  * code : VARCHAR(50) UNIQUE NOT NULL
  * name : VARCHAR(255) NOT NULL
  * price : DECIMAL(10,2) NOT NULL
  discount_rate : INT DEFAULT 0
  brand : VARCHAR(100)
  description : TEXT
  * stock : INT NOT NULL DEFAULT 0
  rating : DECIMAL(2,1) DEFAULT 0.0
  review_count : INT DEFAULT 0
  sales_count : INT DEFAULT 0
  image_url : VARCHAR(500)
  thumbnail_urls : JSON
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "categories" as category {
  * category_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  * name : VARCHAR(100) NOT NULL
  parent_category_id : BIGINT
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "reviews" as review {
  * review_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  --
  * rating : TINYINT CHECK (rating >= 1 AND rating <= 5)
  content : TEXT
  image_url : VARCHAR(500)
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "points" as point {
  * point_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * balance : INT NOT NULL DEFAULT 0
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "point_histories" as point_history {
  * history_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * amount : INT NOT NULL
  * type : ENUM('CHARGE', 'USE') NOT NULL
  description : VARCHAR(255)
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "coupons" as coupon {
  * coupon_id : BIGINT AUTO_INCREMENT <<PK>>
  user_id : BIGINT <<FK>>
  admin_id : BIGINT <<FK>>
  --
  * code : VARCHAR(50) UNIQUE NOT NULL
  * discount_rate : DECIMAL(5,2) NOT NULL
  discount_amount : DECIMAL(10,2)
  min_order_amount : DECIMAL(10,2) DEFAULT 0.00
  max_discount_amount : DECIMAL(10,2)
  * status : ENUM('ACTIVE', 'USED', 'EXPIRED', 'CANCELLED') DEFAULT 'ACTIVE'
  usage_limit : INT DEFAULT 1
  used_count : INT DEFAULT 0
  expired_at : TIMESTAMP
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "notifications" as notification {
  * notification_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * message : TEXT NOT NULL
  * type : ENUM('EMAIL', 'SMS', 'PUSH') NOT NULL
  is_read : TINYINT(1) DEFAULT 0
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "boards" as board {
  * board_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * title : VARCHAR(255) NOT NULL
  * content : TEXT NOT NULL
  view_count : INT DEFAULT 0
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "orders" as orders {
  * order_id : BIGINT AUTO_INCREMENT <<PK>>
  * user_id : BIGINT <<FK>>
  * address_id : BIGINT <<FK>>
  coupon_id : BIGINT <<FK>>
  --
  * order_date : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  * status : ENUM('PENDING', 'PAID', 'PREPARING', 'SHIPPED', 'DELIVERED', 'CANCELLED', 'REFUNDED') DEFAULT 'PENDING'
  * total_amount : DECIMAL(10,2) NOT NULL
  shipping_fee : DECIMAL(8,2) DEFAULT 0.00
  discount_amount : DECIMAL(10,2) DEFAULT 0.00
  points_used : INT DEFAULT 0
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "deliveries" as delivery {
  * delivery_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_id : BIGINT <<FK>>
  --
  tracking_number : VARCHAR(100)
  * status : ENUM('PREPARING', 'SHIPPED', 'IN_TRANSIT', 'DELIVERED') DEFAULT 'PREPARING'
  estimated_date : DATE
  actual_date : DATE
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "banners" as banner {
  * banner_id : BIGINT AUTO_INCREMENT <<PK>>
  * admin_id : BIGINT <<FK>>
  --
  * title : VARCHAR(255) NOT NULL
  * image_url : VARCHAR(500) NOT NULL
  link_url : VARCHAR(500)
  * priority : INT DEFAULT 0
  advertising_cost : DECIMAL(10,2) DEFAULT 0.00
  click_count : INT DEFAULT 0
  view_count : INT DEFAULT 0
  is_active : TINYINT(1) DEFAULT 1
  start_date : TIMESTAMP
  end_date : TIMESTAMP
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "notices" as notice {
  * notice_id : BIGINT AUTO_INCREMENT <<PK>>
  * admin_id : BIGINT <<FK>>
  --
  * title : VARCHAR(255) NOT NULL
  * content : TEXT NOT NULL
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  updated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
}

entity "order_items" as order_item {
  * order_item_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  --
  * quantity : INT NOT NULL
  * price : DECIMAL(10,2) NOT NULL
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "order_histories" as order_history {
  * history_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_id : BIGINT <<FK>>
  --
  * status : ENUM('PENDING', 'PAID', 'PREPARING', 'SHIPPED', 'DELIVERED', 'CANCELLED') NOT NULL
  changed_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "payments" as payment {
  * payment_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_id : BIGINT <<FK>>
  --
  * amount : DECIMAL(10,2) NOT NULL
  * method : ENUM('CREDIT_CARD', 'BANK_TRANSFER', 'KAKAO_PAY', 'NAVER_PAY') NOT NULL
  * status : ENUM('PENDING', 'COMPLETED', 'FAILED', 'REFUNDED') DEFAULT 'PENDING'
  transaction_id : VARCHAR(255)
  paid_at : TIMESTAMP
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "product_options" as product_option {
  * option_id : BIGINT AUTO_INCREMENT <<PK>>
  * product_id : BIGINT <<FK>>
  --
  * option_type : VARCHAR(50) NOT NULL
  * option_value : VARCHAR(100) NOT NULL
  additional_price : DECIMAL(10,2) DEFAULT 0.00
  stock : INT DEFAULT 0
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "phone_verifications" as phone_verification {
  * verification_id : BIGINT AUTO_INCREMENT <<PK>>
  --
  * phone_number : VARCHAR(20) NOT NULL
  * verification_code : VARCHAR(6) NOT NULL
  is_verified : TINYINT(1) DEFAULT 0
  attempt_count : INT DEFAULT 0
  expired_at : TIMESTAMP NOT NULL
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}



entity "product_rankings" as product_ranking {
  * ranking_id : BIGINT AUTO_INCREMENT <<PK>>
  * product_id : BIGINT <<FK>>
  --
  * ranking_type : ENUM('SALES', 'REVIEW', 'DISCOUNT') NOT NULL
  * rank_position : INT NOT NULL
  score : DECIMAL(10,2) NOT NULL
  calculated_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "event_products" as event_product {
  * event_id : BIGINT AUTO_INCREMENT <<PK>>
  * product_id : BIGINT <<FK>>
  * admin_id : BIGINT <<FK>>
  --
  * event_name : VARCHAR(255) NOT NULL
  * discount_rate : INT NOT NULL
  event_start_date : TIMESTAMP NOT NULL
  event_end_date : TIMESTAMP NOT NULL
  is_active : TINYINT(1) DEFAULT 1
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "stock_histories" as stock_history {
  * history_id : BIGINT AUTO_INCREMENT <<PK>>
  * product_id : BIGINT <<FK>>
  order_id : BIGINT <<FK>>
  --
  * change_type : ENUM('ORDER', 'CANCEL', 'REFUND', 'ADJUSTMENT') NOT NULL
  * quantity_change : INT NOT NULL
  * stock_before : INT NOT NULL
  * stock_after : INT NOT NULL
  reason : VARCHAR(255)
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "cart_item_options" as cart_item_option {
  * cart_item_option_id : BIGINT AUTO_INCREMENT <<PK>>
  * cart_item_id : BIGINT <<FK>>
  * option_id : BIGINT <<FK>>
  --
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

entity "order_item_options" as order_item_option {
  * order_item_option_id : BIGINT AUTO_INCREMENT <<PK>>
  * order_item_id : BIGINT <<FK>>
  * option_id : BIGINT <<FK>>
  --
  created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP
}

' ======================
' Relationships
' ======================

user ||--o{ address : has
user ||--o{ cart : owns
user ||--o{ phone_verification : requests

cart ||--o{ cart_item : contains
cart_item }o--|| product : refers
cart_item ||--o{ cart_item_option : has
cart_item_option }o--|| product_option : selects

category ||--o{ product : contains
product ||--o{ product_option : has
product ||--o{ review : has
product ||--o{ product_ranking : ranked
product ||--o{ event_product : featured
product ||--o{ stock_history : tracks

user ||--o{ review : writes

user ||--o{ point : has
point ||--o{ point_history : logs

user ||--o{ coupon : has
user ||--o{ notification : receives
user ||--o{ board : writes

user ||--o{ orders : places
orders }o--|| address : ships_to
orders }o--o| coupon : uses
orders ||--|| delivery : tracked_by
orders ||--o{ order_item : includes
orders ||--o{ order_history : changes
orders ||--o{ stock_history : affects

order_item }o--|| product : refers
order_item ||--o{ order_item_option : has
order_item_option }o--|| product_option : selects

orders ||--|| payment : paid_by

admin ||--o{ banner : manages
admin ||--o{ notice : manages
admin ||--o{ coupon : creates
admin ||--o{ event_product : manages

@enduml
