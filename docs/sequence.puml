@startuml
actor User
boundary Browser
control AuthController
control OrderController
control PaymentController
control ProductController
control CartController
entity UserService
entity OrderService
entity ShoppingCartService
entity ProductService
entity StockService
entity PointService
entity CouponService
entity SmsService
database DB
control JwtProvider
entity PaymentGateway
entity OAuthProvider

== OAuth 회원가입 ==
User -> Browser : 소셜 로그인 선택 (카카오/구글/네이버)
Browser -> AuthController : GET /oauth/{provider}/login
AuthController -> OAuthProvider : 인증 요청
OAuthProvider --> Browser : 인증 페이지 리다이렉트
User -> OAuthProvider : 로그인 정보 입력
OAuthProvider -> AuthController : 인증 코드 전달
AuthController -> OAuthProvider : 액세스 토큰 요청
OAuthProvider --> AuthController : 액세스 토큰
AuthController -> OAuthProvider : 사용자 정보 요청
OAuthProvider --> AuthController : 사용자 정보 (이메일, 이름)
AuthController -> UserService : findByEmail(email)
UserService -> DB : SELECT * FROM users WHERE email=?
alt 기존 회원인 경우
    DB --> UserService : 사용자 존재
    UserService --> AuthController : 기존 사용자
    AuthController -> JwtProvider : generateTokens(user)
    AuthController --> Browser : 메인페이지 리다이렉트
else 신규 회원인 경우
    DB --> UserService : 사용자 없음
    UserService --> AuthController : 신규 사용자
    alt 전화번호 정보 있는 경우
        AuthController -> UserService : createUser(oauthInfo)
        UserService -> DB : INSERT INTO users
        UserService -> PointService : grantWelcomePoints(userId, 5000)
        PointService -> DB : INSERT INTO points
        AuthController --> Browser : 회원가입 완료, 메인페이지 리다이렉트
    else 전화번호 정보 없는 경우
        AuthController --> Browser : 전화번호 입력 페이지 리다이렉트
    end
end

== 전화번호 인증 ==
User -> Browser : 전화번호 입력
Browser -> AuthController : POST /verify-phone (phoneNumber)
AuthController -> UserService : checkPhoneDuplicate(phoneNumber)
UserService -> DB : SELECT * FROM users WHERE phone_number=?
alt 중복된 전화번호인 경우
    DB --> UserService : 전화번호 존재
    UserService --> AuthController : 중복 오류
    AuthController --> Browser : "이미 가입된 회원입니다" 메시지
else 사용 가능한 전화번호인 경우
    DB --> UserService : 전화번호 없음
    UserService --> AuthController : 사용 가능
    AuthController -> SmsService : sendVerificationCode(phoneNumber)
    SmsService -> DB : INSERT INTO phone_verifications
    SmsService --> AuthController : 인증번호 발송 완료
    AuthController --> Browser : 인증번호 입력 화면
    User -> Browser : 인증번호 입력
    Browser -> AuthController : POST /verify-code (phoneNumber, code)
    AuthController -> SmsService : verifyCode(phoneNumber, code)
    SmsService -> DB : SELECT * FROM phone_verifications
    alt 인증 성공
        SmsService -> DB : UPDATE phone_verifications SET is_verified=true
        SmsService --> AuthController : 인증 성공
        AuthController -> UserService : completeRegistration(oauthInfo, phoneNumber)
        UserService -> DB : INSERT INTO users
        UserService -> PointService : grantWelcomePoints(userId, 5000)
        AuthController --> Browser : 회원가입 완료
    else 인증 실패
        SmsService --> AuthController : 인증 실패
        AuthController --> Browser : 인증번호 오류 메시지
    end
end

== 로그인 ==
User -> Browser : 로그인 요청 (id, pw)
Browser -> AuthController : POST /login
AuthController -> UserService : validateUser(id, pw)
UserService -> DB : SELECT * FROM user
DB --> UserService : User data
UserService --> AuthController : 인증 성공
AuthController -> JwtProvider : generateAccessToken(user)
AuthController -> JwtProvider : generateRefreshToken(user)
JwtProvider --> AuthController : tokens
AuthController --> Browser : Response\nAccessToken(JSON), RefreshToken(Cookie)

== 장바구니 담기 ==
User -> Browser : 상품 상세페이지에서 옵션 선택 후 장바구니 담기
Browser -> CartController : POST /cart/add (productId, quantity, options)
CartController -> JwtProvider : validateAccessToken()
CartController -> ProductService : getProduct(productId)
ProductService -> DB : SELECT * FROM products WHERE product_id=?
CartController -> StockService : checkStock(productId, options, quantity)
StockService -> DB : SELECT stock FROM product_options
alt 재고 충분한 경우
    StockService --> CartController : 재고 확인 완료
    CartController -> ShoppingCartService : addToCart(userId, productId, quantity, options)
    ShoppingCartService -> DB : INSERT INTO cart_items
    CartController --> Browser : 장바구니 담기 성공
else 재고 부족한 경우
    StockService --> CartController : 재고 부족
    CartController --> Browser : 재고 부족 오류 메시지
end

== 주문 ==
User -> Browser : 장바구니에서 상품 선택 후 주문하기
Browser -> OrderController : POST /order (selectedItems, addressId, couponId, pointsToUse)
OrderController -> JwtProvider : validateAccessToken()
OrderController -> ShoppingCartService : getSelectedItems(userId, selectedItems)
ShoppingCartService -> DB : SELECT * FROM cart_items WHERE cart_item_id IN (?)
OrderController -> StockService : validateAndReserveStock(items)
loop 각 상품별로
    StockService -> DB : SELECT stock FROM products WHERE product_id=?
    alt 재고 충분한 경우
        StockService -> DB : UPDATE products SET stock = stock - ? WHERE product_id=?
        StockService -> DB : INSERT INTO stock_histories
    else 재고 부족한 경우
        StockService --> OrderController : 재고 부족 오류
        OrderController --> Browser : 재고 부족 상품 안내
        return
    end
end
OrderController -> OrderService : calculateOrderAmount(items, addressId)
alt 쿠폰 사용하는 경우
    OrderController -> CouponService : validateAndApplyCoupon(couponId, orderAmount)
    CouponService -> DB : SELECT * FROM coupons WHERE coupon_id=?
    CouponService --> OrderController : 할인 금액
end
alt 포인트 사용하는 경우
    OrderController -> PointService : validatePointUsage(userId, pointsToUse, orderAmount)
    PointService -> DB : SELECT balance FROM points WHERE user_id=?
    PointService --> OrderController : 포인트 사용 가능
end
OrderController -> OrderService : createOrder(orderInfo)
OrderService -> DB : INSERT INTO orders
OrderService -> DB : INSERT INTO order_items
OrderService --> OrderController : 주문 생성 완료

== 결제 ==
OrderController -> PaymentController : 결제 요청(orderId, 최종금액)
PaymentController -> PaymentGateway : 결제 API 호출
alt 결제 성공
    PaymentGateway --> PaymentController : 결제 성공
    PaymentController -> DB : INSERT INTO payments
    PaymentController -> DB : UPDATE orders SET status='PAID'
    alt 쿠폰 사용한 경우
        PaymentController -> CouponService : markCouponAsUsed(couponId)
        CouponService -> DB : UPDATE coupons SET status='USED'
    end
    alt 포인트 사용한 경우
        PaymentController -> PointService : deductPoints(userId, pointsUsed)
        PointService -> DB : UPDATE points SET balance = balance - ?
        PointService -> DB : INSERT INTO point_histories
    end
    PaymentController -> ShoppingCartService : clearSelectedItems(userId, selectedItems)
    ShoppingCartService -> DB : DELETE FROM cart_items WHERE cart_item_id IN (?)
    PaymentController --> OrderController : 결제 완료
    OrderController --> Browser : 주문 및 결제 완료
else 결제 실패
    PaymentGateway --> PaymentController : 결제 실패
    PaymentController -> StockService : restoreStock(orderItems)
    StockService -> DB : UPDATE products SET stock = stock + ?
    PaymentController -> DB : UPDATE orders SET status='CANCELLED'
    PaymentController --> OrderController : 결제 실패
    OrderController --> Browser : 결제 실패 메시지
end

== 상품 랭킹 업데이트 (배치 작업) ==
participant BatchScheduler
BatchScheduler -> ProductService : updateSalesRanking()
ProductService -> DB : SELECT product_id, SUM(quantity) as sales_count FROM order_items oi JOIN orders o ON oi.order_id = o.order_id WHERE o.status = 'DELIVERED' AND o.order_date >= DATE_SUB(NOW(), INTERVAL 30 DAY) GROUP BY product_id
ProductService -> DB : UPDATE product_rankings SET rank = ?, score = ? WHERE ranking_type = 'SALES'
BatchScheduler -> ProductService : updateReviewRanking()
ProductService -> DB : SELECT product_id, COUNT(*) as review_count, AVG(rating) as avg_rating FROM reviews GROUP BY product_id HAVING avg_rating >= 4.0 AND review_count >= 10
ProductService -> DB : UPDATE product_rankings SET rank = ?, score = ? WHERE ranking_type = 'REVIEW'

== 광고 배너 우선순위 계산 ==
participant BannerService
BannerService -> DB : SELECT * FROM banners WHERE is_active = true AND start_date <= NOW() AND end_date >= NOW()
loop 각 배너별로
    BannerService -> DB : SELECT click_count, view_count FROM banners WHERE banner_id = ?
    BannerService -> BannerService : calculatePriorityScore(advertisingCost, clickRate)
    BannerService -> DB : UPDATE banners SET priority = ? WHERE banner_id = ?
end
BannerService -> DB : SELECT * FROM banners WHERE is_active = true ORDER BY priority DESC LIMIT 5

@enduml
